# Either set DATABASE_URL directly...
DATABASE_URL=postgres://readonly_user:changeme@localhost:5432/mydb?sslmode=disable

# ...or manage named profiles instead (see `dbcli profiles add`), which are
# stored in ~/.config/dbcli/profiles.env in this same key=value format:
# PROFILE_DEV=postgres://readonly_user:changeme@localhost:5432/mydb?sslmode=disable
# PROFILE_PROD=postgres://readonly_user:changeme@prod-host:5432/mydb
